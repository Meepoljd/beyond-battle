# No provider credentials are used by this build.
BATTLE_DB=/absolute/path/to/independent/battle.sqlite3
BATTLE_PORT=8765
# run.sh reads exported variables. It does not automatically load this file.

# Optional OpenCode 1.19.5 server. All three settings are required to enable it.
# Start with scripts/run-opencode.sh in a separate terminal; use game-only auth.
# BATTLE_OPENCODE_URL=http://127.0.0.1:4096
# BATTLE_OPENCODE_MODEL=provider/model
# BATTLE_OPENCODE_MAX_CALLS=48
# BATTLE_OPENCODE_TIMEOUT=20
# BATTLE_OPENCODE_USERNAME=opencode
# BATTLE_OPENCODE_PASSWORD must match the server's OPENCODE_SERVER_PASSWORD.
# Enter passwords securely in the runtime environment; never commit them.

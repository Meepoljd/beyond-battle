  "components": {
    "schemas": {
      "CreateMatch": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "const": "bridge_v1",
            "title": "Scenario Id",
            "default": "bridge_v1"
          },
          "commander_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Commander Ids"
          },
          "seed": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 42
          },
          "provider_mode": {
            "type": "string",
            "enum": [
              "rules",
              "opencode"
            ],
            "title": "Provider Mode",
            "default": "rules"
          },
          "use_memories": {
            "type": "boolean",
            "title": "Use Memories",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CreateMatch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MemoryState": {
        "properties": {
          "active": {
            "type": "boolean",
            "title": "Active"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "active"
        ],
        "title": "MemoryState"
      },
      "Order": {
        "properties": {
          "match_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Match Version"
          },
          "unit_id": {
            "type": "string",
            "maxLength": 30,
            "title": "Unit Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "MOVE",
              "HOLD",
              "OBSERVE",
              "ATTACK",
              "SUPPORT",
              "WITHDRAW",
              "REST"
            ],
            "title": "Action"
          },
          "target": {
            "type": "string",
            "maxLength": 30,
            "title": "Target"
          },
          "priority": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Priority",
            "default": 1
          },
          "expires_tick": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Expires Tick"
          },
          "direct": {
            "type": "boolean",
            "title": "Direct",
            "default": false
          },
          "autonomy": {
            "type": "boolean",
            "title": "Autonomy",
            "default": true
          },
          "retreat_threshold": {
            "type": "integer",
            "maximum": 15.0,
            "minimum": 0.0,
            "title": "Retreat Threshold",
            "default": 7
          },
          "silent_until": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Silent Until",
            "default": 0
          },
          "supersedes_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
              }
            ],
            "title": "Supersedes Id"
          },
          "text": {
            "type": "string",
            "maxLength": 600,
            "title": "Text",
            "default": ""
          },
          "report_before_withdraw": {
            "type": "boolean",
            "title": "Report Before Withdraw",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "match_version",
          "unit_id",
          "action",
          "target",
          "expires_tick"
        ],
        "title": "Order"
      },
      "Review": {
        "properties": {
          "accepted_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Accepted Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accepted_ids"
        ],
        "title": "Review"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Version": {
        "properties": {
          "match_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Match Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "match_version"
        ],
        "title": "Version"
      }
    }
  }
}
